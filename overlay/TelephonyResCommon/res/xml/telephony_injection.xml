<!-- The stock QtiTelephonyComponentFactory jar is not shipped by Evo. Only replace
     display-controller construction; every other component keeps the AOSP factory. -->
<injection package="org.lineageos.annibale.telephony.AnnibaleTelephonyComponentFactory"
           jar="/system_ext/framework/annibale-telephony.jar:/system_ext/framework/extphonelib.jar">
    <components>
        <component>com.android.internal.telephony.DisplayInfoController</component>
    </components>
</injection>

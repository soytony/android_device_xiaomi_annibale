java_library {
    name: "annibale-miui-camera-framework",
    srcs: ["src/**/*.java"],
    platform_apis: true,
    installable: true,
    system_ext_specific: true,
}
prebuilt_etc {
    name: "annibale-miui-camera-framework-permissions",
    src: "permissions/annibale-miui-camera-framework.xml",
    filename_from_src: true,
    sub_dir: "permissions",
    system_ext_specific: true,
}

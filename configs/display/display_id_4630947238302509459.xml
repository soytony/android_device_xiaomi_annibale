<?xml version='1.0' encoding='utf-8' standalone='yes' ?>
<displayConfiguration>
    <!-- Global Brightness-Nit mapping -->
    <screenBrightnessMap>
        <point>
            <value>0.000244171</value>
            <nits>1.0</nits>
        </point>
        <point>
            <value>0.037113906</value>
            <nits>60</nits>
        </point>
        <point>
            <value>0.411976560</value>
            <nits>800.0</nits>
        </point>
        <point>
            <value>0.824014162</value>
            <nits>2000.0</nits>
        </point>
        <point>
            <value>1.0</value>
            <nits>3500.0</nits>
        </point>
    </screenBrightnessMap>
    <!-- root node for HBM-->
    <highBrightnessMode enabled="true">
        <!-- Transition point brightness from normal to HBM mode -->
        <transitionPoint>0.310687908</transitionPoint>
        <!-- Minimum lux to enter HBM -->
        <minimumLux>5090</minimumLux>
        <!-- Time limitation for HBM-->
        <timing>
            <timeWindowSecs>0</timeWindowSecs>
            <timeMaxSecs>0</timeMaxSecs>
            <timeMinSecs>0</timeMinSecs>
        </timing>
        <!--Refresh rate limitation when the device is in HBM -->
        <!-- <refreshRate>
            <minimum>0</minimum>
            <maximum>0</maximum>
        </refreshRate> -->
        <!-- Thermal limitation for HBM -->
        <thermalStatusLimit>critical</thermalStatusLimit>
        <!-- Low power mode limitation for HBM -->
        <allowInLowPowerMode>true</allowInLowPowerMode>
        <minimumHdrPercentOfScreen>0</minimumHdrPercentOfScreen>
        <sdrHdrRatioMap>
            <point>
                <sdrNits>2.0</sdrNits>
                <hdrRatio>8.0</hdrRatio>
            </point>
            <point>
                <sdrNits>2000.0</sdrNits>
                <hdrRatio>8.0</hdrRatio>
            </point>
        </sdrHdrRatioMap>
    </highBrightnessMode>
    <!-- Keep enough history for the 3000 ms darkening debounce. A shorter
         horizon continually advances the oldest sample and prevents dimming. -->
    <ambientLightHorizonLong>4000</ambientLightHorizonLong>
    <ambientLightHorizonShort>1000</ambientLightHorizonShort>
    <idleScreenRefreshRateTimeout>
        <luxThresholds>
           <point>
              <lux>0</lux>
              <timeout>1100</timeout>
           </point>
       </luxThresholds>
    </idleScreenRefreshRateTimeout>
</displayConfiguration>

+                && (getRawDataNetworkType() == TelephonyManager.NETWORK_TYPE_NR
+                    || (isLte(getRawDataNetworkType()) && mServiceState.getNrState()
+                        == NetworkRegistrationInfo.NR_STATE_CONNECTED));
+        return nrCarrierAggregation || modemAdvanced
+                || isNrMmwave() || isAdditionalNrAdvancedBand(bands);
     }
 

+    private void assertAidlRadioTechnology(int rat, int expectedNetworkType,
+            boolean expectedAggregation) throws RemoteException {
+        android.hardware.radio.network.RegStateResult result =
+                new android.hardware.radio.network.RegStateResult();
+        result.regState = NetworkRegistrationInfo.REGISTRATION_STATE_HOME;
+        result.rat = rat;
+        result.cellIdentity = new android.hardware.radio.network.CellIdentity();
+        result.registeredPlmn = "";
+        result.accessTechnologySpecificInfo =
+                android.hardware.radio.network.AccessTechnologySpecificInfo.noinit(false);
+        mSimulatedCommands.setVoiceRegStateResult(result);
+        mSimulatedCommands.setDataRegStateResult(result);
+
+        for (int domain : new int[] {NetworkRegistrationInfo.DOMAIN_CS,
+                NetworkRegistrationInfo.DOMAIN_PS}) {
+            INetworkServiceCallback callback = mock(INetworkServiceCallback.class);
+            ArgumentCaptor<NetworkRegistrationInfo> info =
+                    ArgumentCaptor.forClass(NetworkRegistrationInfo.class);
+            mBinder.requestNetworkRegistrationInfo(0, domain, callback);
+            verify(callback, timeout(1000)).onRequestNetworkRegistrationInfoComplete(
+                    eq(NetworkServiceCallback.RESULT_SUCCESS), info.capture());
+            assertEquals(domain, info.getValue().getDomain());
+            assertEquals(expectedNetworkType, info.getValue().getAccessNetworkTechnology());
+            assertEquals(expectedAggregation, info.getValue().isUsingCarrierAggregation());
+        }
+    }

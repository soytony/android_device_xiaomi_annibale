+// generatePrebuiltHeaders installs an already exported UAPI tree. Unlike a
+// kernel build, its complete output set is known before execution.
+func (g *Module) generatePrebuiltHeaders(ctx android.ModuleContext, dir string) {
+	headers, err := ctx.GlobWithDeps(filepath.Join(dir, "**/*.h"), nil)
+	if err != nil || len(headers) == 0 {
+		ctx.PropertyErrorf("prebuilt_header_dir", "no headers in %q: %v", dir, err)
+		return
+	}
+	genDir := android.PathForModuleGen(ctx)
+	rule := android.NewRuleBuilder(pctx, ctx).Sbox(genDir,
+		android.PathForModuleOut(ctx, "generator.sbox.textproto"))
+	cmd := rule.Command()
+	includeDir := genDir.Join(ctx, "usr/include")
+	cmd.Text("mkdir -p").Text(proptools.ShellEscape(cmd.PathForOutput(includeDir))).
+		Text("&& cp -R").Text(proptools.ShellEscape(dir + "/.")).
+		Text(proptools.ShellEscape(cmd.PathForOutput(includeDir)))
+	for _, header := range headers {
+		rel, err := filepath.Rel(dir, header)
+		if err != nil {
+			ctx.PropertyErrorf("prebuilt_header_dir", "%v", err)
+			return
+		}
+		cmd.Implicit(android.PathForSource(ctx, header)).
+			ImplicitOutput(genDir.Join(ctx, "usr/include", rel))
+	}
+	// clean_header.py imports these modules and loads clang-stable's bindings
+	// and shared library. All must be present inside the input sandbox.
+	for _, pattern := range []string{
+		"bionic/libc/kernel/tools/*.py",
+		"prebuilts/clang/host/linux-x86/clang-stable/lib/python3/site-packages/clang/*.py",
+		"prebuilts/clang/host/linux-x86/clang-stable/lib/libclang.so",
+		"vendor/lineage/tools/clean_headers.sh",
+	} {
+		paths, err := ctx.GlobWithDeps(pattern, nil)
+		if err != nil || len(paths) == 0 {
+			ctx.ModuleErrorf("missing header cleanup dependency %q: %v", pattern, err)
+			return
+		}
+		for _, path := range paths {
+			cmd.Implicit(android.PathForSource(ctx, path))
+		}
+	}
+	// Absolute paths avoid clean_header.py resolving its arguments beneath
+	// external/kernel-headers/original instead of the generated directory.
+	cmd.Text("&& vendor/lineage/tools/clean_headers.sh \"$(realpath").
+		Text(proptools.ShellEscape(cmd.PathForOutput(genDir))).Text(")\"")
+	dummyDep := genDir.Join(ctx, ".dummy_dep")
+	rule.Command().Text("touch").Output(dummyDep)
+	g.outputDeps = append(g.outputDeps, dummyDep)
+	rule.Build("generator", "install prebuilt kernel headers")
+}
+
 func NewGenerator() *Module {
 	module := &Module{}
 	module.AddProperties(&module.properties)
